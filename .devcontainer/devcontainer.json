{
  "name": "wildfx-reaper",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },

  // JACK uses its dummy device by default, so this works on headless servers.
  // Add a dataset mount locally only when a particular run needs one.
  "runArgs": ["--init", "--shm-size=2g"],

  // Docker bind mounts require every host source to exist. These are empty
  // mount points only; this command does not install or copy any plugins.
  "initializeCommand": "mkdir -p \"${localEnv:HOME}/.vst3\" \"${localEnv:HOME}/.vst\" \"${localEnv:HOME}/.clap\" \"${localEnv:HOME}/.lv2\"",

  // Host plugins are read-only. entrypoint.sh makes a clean internal copy and
  // excludes __MACOSX metadata, which otherwise causes false REAPER scan errors.
  "mounts": [
    "source=${localEnv:HOME}/.vst3,target=/plugins-host/.vst3,type=bind,readonly",
    "source=${localEnv:HOME}/.vst,target=/plugins-host/.vst,type=bind,readonly",
    "source=${localEnv:HOME}/.clap,target=/plugins-host/.clap,type=bind,readonly",
    "source=${localEnv:HOME}/.lv2,target=/plugins-host/.lv2,type=bind,readonly"
  ],

  "remoteUser": "u1",
  "containerUser": "u1",
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  },
  "postCreateCommand": "bash ${containerWorkspaceFolder}/.devcontainer/postCreateCommand.sh"
}
